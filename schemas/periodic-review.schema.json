{
  "$defs": {
    "ReviewMetrics": {
      "properties": {
        "alcoa_failures": {
          "title": "Alcoa Failures",
          "type": "integer"
        },
        "audit_chains_verified": {
          "title": "Audit Chains Verified",
          "type": "integer"
        },
        "audit_events_verified": {
          "title": "Audit Events Verified",
          "type": "integer"
        },
        "audit_integrity": {
          "title": "Audit Integrity",
          "type": "boolean"
        },
        "definitions_retired": {
          "items": {
            "type": "string"
          },
          "title": "Definitions Retired",
          "type": "array"
        },
        "definitions_validated": {
          "items": {
            "type": "string"
          },
          "title": "Definitions Validated",
          "type": "array"
        },
        "executions_completed": {
          "title": "Executions Completed",
          "type": "integer"
        },
        "executions_failed": {
          "title": "Executions Failed",
          "type": "integer"
        },
        "failure_rate": {
          "title": "Failure Rate",
          "type": "number"
        },
        "requests_by_status": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Requests By Status",
          "type": "object"
        },
        "signatures_by_meaning": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Signatures By Meaning",
          "type": "object"
        }
      },
      "required": [
        "requests_by_status",
        "executions_completed",
        "executions_failed",
        "failure_rate",
        "signatures_by_meaning",
        "alcoa_failures",
        "definitions_validated",
        "definitions_retired",
        "audit_events_verified",
        "audit_chains_verified",
        "audit_integrity"
      ],
      "title": "ReviewMetrics",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "draft",
        "approved"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/gxp-agent-runtime/schemas/periodic-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Periodic evaluation that a validated system remains in a validated state.",
  "properties": {
    "approval_signature_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Signature Id"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "conclusion": {
      "enum": [
        "remains-validated",
        "remediation-required"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "title": "Generated By",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/ReviewMetrics"
    },
    "period_end": {
      "format": "date-time",
      "title": "Period End",
      "type": "string"
    },
    "period_start": {
      "format": "date-time",
      "title": "Period Start",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "draft"
    },
    "system_id": {
      "title": "System Id",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "system_id",
    "period_start",
    "period_end",
    "generated_at",
    "generated_by",
    "metrics",
    "findings",
    "conclusion"
  ],
  "title": "PeriodicReview",
  "type": "object"
}
